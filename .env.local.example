# Copy this file to .env.local and fill in your real keys.
# .env.local is git-ignored -- it will never be committed.
#
# Two keys are required (one per API):
#   1. DASHSCOPE_API_KEY  -> Alibaba Cloud Bailian (DashScope) STT
#   2. DEEPSEEK_API_KEY   -> DeepSeek LLM manuscript polishing
#
# Get a DashScope key: https://help.aliyun.com/zh/model-studio/get-api-key
# Get a DeepSeek key:  https://platform.deepseek.com/api_keys

DASHSCOPE_API_KEY=your_dashscope_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here

# Optional overrides (usually not needed):
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# DASHSCOPE_STT_MODEL=qwen-audio-3.1-asr-flash-filetrans
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
